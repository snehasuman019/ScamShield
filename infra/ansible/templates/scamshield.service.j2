[Unit]
Description=ScamShield AI Job Fraud Detection - Streamlit Application
After=network.target
Wants=network-online.target

[Service]
Type=simple
User={{ app_user }}
WorkingDirectory={{ app_dir }}
ExecStart={{ venv_dir }}/bin/streamlit run app.py --server.port {{ app_port }} --server.address 0.0.0.0
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=scamshield
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
